def increment_string(string):
    if len(string)==0:
        return "1"
    i = len(string) - 1
    while i >= 0 and string[i].isdigit():
        i -= 1

    letters = string[:i+1]
    numbers = string[i+1:]
    
    if numbers=='':
        return string+"1"

    return letters+str(int(numbers)+1).zfill(len(numbers))

def is_valid_walk(walk):
    count1=0
    count2=0
    if len(walk)!=10:
        return False
    for i in walk:
        if i=='n':
            count1+=1
        if i=='e':
            count2+=1
        if i=='s':
            count1-=1
        if i=='w':
            count2-=1
    if count1==0 and count2==0:
        return True
    else:
        return False

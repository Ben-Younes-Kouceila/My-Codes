def score(dice):
    res=0
    if dice.count(1)<3:
        res+=dice.count(1)*100
    elif dice.count(1)>=3:
        res+=(1000 + (dice.count(1)-3)*100)
    if dice.count(5)<3:
        res+=dice.count(5)*50
    elif dice.count(5)>=3:
        res+=(500 + (dice.count(5)-3)*50)
    if dice.count(2)>2:
        res+=200
    if dice.count(3)>2:
        res+=300
    if dice.count(4)>2:
        res+=400
    if dice.count(6)>2:
        res+=600
    return res
